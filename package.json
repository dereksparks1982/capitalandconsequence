{
  "name": "federal-electric",
  "version": "0.6.6",
  "private": true,
  "description": "Federal Electric desktop alpha",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:runtime": "node desktop/prepare-runtime-assets.cjs",
    "prestart": "npm run prepare:runtime",
    "start": "electron .",
    "pack:linux": "electron-builder --linux dir --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "audit:offline": "node desktop/check-offline-runtime.cjs",
    "audit:artwork": "node desktop/check-artwork-paths.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.elderredsoftworks.federalelectric",
    "productName": "Federal Electric",
    "artifactName": "Federal-Electric-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "*.js",
      "*.css",
      "assets/**/*",
      "radio/**/*",
      "vendor/**/*",
      "desktop/main.cjs"
    ],
    "asarUnpack": [
      "assets/audio/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "federal-electric"
    }
  },
  "author": "Elderred Softworks LLC"
}
