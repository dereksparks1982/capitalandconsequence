{
  "name": "capital-consequence",
  "version": "0.7.31",
  "private": true,
  "description": "Capital & Consequence historical Washington life simulation (development beta)",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:runtime": "node desktop/prepare-runtime-assets.cjs",
    "prestart": "npm run prepare:runtime",
    "start": "electron .",
    "pack:linux": "electron-builder --linux dir --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "audit:offline": "node desktop/check-offline-runtime.cjs",
    "audit:artwork": "node desktop/check-artwork-paths.cjs",
    "test:source": "node tests/run-all.cjs",
    "audit:bundle": "node desktop/check-bundle-assets.cjs",
    "predist:linux": "npm run prepare:runtime",
    "prepack:linux": "npm run prepare:runtime",
    "dist:linux:portable": "electron-builder --linux tar.gz --x64 --publish never",
    "predist:linux:portable": "npm run prepare:runtime"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.elderredsoftworks.federalelectric",
    "productName": "Capital & Consequence",
    "artifactName": "Capital-and-Consequence-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "*.js",
      "*.css",
      "assets/**/*",
      "radio/**/*",
      "vendor/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/save-store.cjs",
      "desktop/npc-llm.cjs",
      "LICENSE",
      "LEGAL.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asarUnpack": [
      "assets/audio/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "capital-consequence",
      "syncDesktopName": true
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "author": "Elderred Softworks LLC",
  "license": "UNLICENSED",
  "desktopName": "com.elderredsoftworks.federalelectric.desktop"
}
